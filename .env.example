DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Local development can use a local PostgreSQL URL. Render production must use the Neon pooled URL with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_ID_HEADER=HTTP_X_REQUEST_ID
LOG_LEVEL=INFO
OTP_AUTH_PROVIDER=apps.accounts.otp.providers.Msg91OtpProvider
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY_MINUTES=5
DEV_PHONE_LOGIN_ENABLED=false
DEV_PHONE_LOGIN_ALLOWED_NUMBERS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Use LocalRazorpayAdapter for offline dev, or RazorpayApiAdapter with real Razorpay test/live keys.
RAZORPAY_ADAPTER=apps.payments.providers.LocalRazorpayAdapter
NOTIFICATION_PROVIDER=apps.notifications.providers.LocalNotificationProvider
SHOW_API_DOCS=true
DRF_THROTTLE_ANON=100/min
DRF_THROTTLE_USER=1000/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_PAYMENT=30/min
DRF_THROTTLE_WEBHOOK=120/min

# Render + Neon + Netlify deployment example:
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<set in Render, never commit>
# DEBUG=False
# ALLOWED_HOSTS=ps-core.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
# CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.netlify.app
# CSRF_TRUSTED_ORIGINS=https://ps-core.onrender.com,https://YOUR_FRONTEND_DOMAIN.netlify.app
