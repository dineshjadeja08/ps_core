DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local development can use a local PostgreSQL URL. Render production must use the Neon pooled URL with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_ID_HEADER=HTTP_X_REQUEST_ID
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret
JWT_ISSUER=purple-squad-api
ADMIN_MFA_ENABLED=false
DRF_NUM_PROXIES=0
DRF_THROTTLE_LOGIN_IP=10/min
DRF_THROTTLE_LOGIN_PHONE=5/min
DRF_THROTTLE_PAYMENT_IP=30/min
DRF_THROTTLE_PAYMENT_USER=20/min
DRF_THROTTLE_LOCATION=60/min
LOCATION_PROVIDER=apps.locations.providers.GoogleMapsLocationProvider
GOOGLE_MAPS_API_KEY=
LOCATION_PROVIDER_TIMEOUT_SECONDS=8
LOCATION_REVERSE_CACHE_SECONDS=86400
LOCATION_AUTOCOMPLETE_CACHE_SECONDS=3600
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=purplesquad
BUSINESS_LEGAL_NAME=Purple Squad
BUSINESS_GSTIN=
BUSINESS_ADDRESS=Chennai, Tamil Nadu, India
DEV_PHONE_LOGIN_ENABLED=false
DEV_PHONE_LOGIN_ALLOWED_NUMBERS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Use LocalRazorpayAdapter for offline dev, or RazorpayApiAdapter with real Razorpay test/live keys.
RAZORPAY_ADAPTER=apps.payments.providers.LocalRazorpayAdapter
USE_CLOUDINARY_MEDIA=false
# Production can use either CLOUDINARY_URL or the three individual Cloudinary values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOTIFICATION_PROVIDER=apps.notifications.fcm.FirebaseCloudMessagingProvider
SHOW_API_DOCS=true
DRF_THROTTLE_ANON=100/min
DRF_THROTTLE_USER=1000/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_PAYMENT=30/min
DRF_THROTTLE_WEBHOOK=120/min

# Render + Neon + Netlify deployment example:
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<set in Render, never commit>
# DEBUG=False
# ALLOWED_HOSTS=ps-core.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
# CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.netlify.app
# CSRF_TRUSTED_ORIGINS=https://ps-core.onrender.com,https://YOUR_FRONTEND_DOMAIN.netlify.app
# USE_CLOUDINARY_MEDIA=true
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
