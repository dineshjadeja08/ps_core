DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local development can use a local PostgreSQL URL. Render production must use the Neon pooled URL with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_ID_HEADER=HTTP_X_REQUEST_ID
LOG_LEVEL=INFO
OTP_AUTH_PROVIDER=apps.accounts.otp.providers.Msg91OtpProvider
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=
MSG91_WHATSAPP_TEMPLATE_LANGUAGE=en
MSG91_WHATSAPP_NOTIFICATION_TEMPLATE_NAME=
MSG91_WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
MSG91_WHATSAPP_TEMPLATE_PAYMENT_SUCCESSFUL=
MSG91_WHATSAPP_TEMPLATE_PAYMENT_FAILED=
MSG91_WHATSAPP_TEMPLATE_TECHNICIAN_ASSIGNED=
MSG91_WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=
MSG91_WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
MSG91_WHATSAPP_TEMPLATE_REFUND_INITIATED=
MSG91_WHATSAPP_TEMPLATE_REFUND_COMPLETED=
MSG91_WEBHOOK_SECRET=
REQUIRE_OTP_PROVIDER_CONFIG=false
DEV_PHONE_LOGIN_ENABLED=false
DEV_PHONE_LOGIN_ALLOWED_NUMBERS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Use LocalRazorpayAdapter for offline dev, or RazorpayApiAdapter with real Razorpay test/live keys.
RAZORPAY_ADAPTER=apps.payments.providers.LocalRazorpayAdapter
USE_CLOUDINARY_MEDIA=false
# Production can use either CLOUDINARY_URL or the three individual Cloudinary values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOTIFICATION_PROVIDER=apps.notifications.providers.Msg91WhatsAppNotificationProvider
SHOW_API_DOCS=true
DRF_THROTTLE_ANON=100/min
DRF_THROTTLE_USER=1000/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_PAYMENT=30/min
DRF_THROTTLE_WEBHOOK=120/min

# Render + Neon + Netlify deployment example:
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<set in Render, never commit>
# DEBUG=False
# ALLOWED_HOSTS=ps-core.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
# CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.netlify.app
# CSRF_TRUSTED_ORIGINS=https://ps-core.onrender.com,https://YOUR_FRONTEND_DOMAIN.netlify.app
# USE_CLOUDINARY_MEDIA=true
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
