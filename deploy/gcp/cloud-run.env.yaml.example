DJANGO_SETTINGS_MODULE: config.settings.production
DEBUG: "false"
ALLOWED_HOSTS: .run.app,api.purplesquad.in
CORS_ALLOWED_ORIGINS: https://purplesquad.in
CSRF_TRUSTED_ORIGINS: https://purplesquad.in,https://api.purplesquad.in
FIREBASE_PROJECT_ID: purplesquad
NOTIFICATION_PROVIDER: apps.notifications.fcm.FirebaseCloudMessagingProvider
DEV_PHONE_LOGIN_ENABLED: "false"
SHOW_API_DOCS: "false"
LOG_LEVEL: INFO
DRF_NUM_PROXIES: "1"
USE_CLOUDINARY_MEDIA: "true"
RAZORPAY_ADAPTER: apps.payments.providers.RazorpayApiAdapter
